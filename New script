-- == БЕЗОПАСНЫЙ ОБХОД АНТИЧИТА (для Speed) ==
local function protectHumanoid(hum)
    if not hum then return end
    pcall(function()
        local mt = getmetatable(hum)
        if mt then
            local oldIndex = mt.__index
            mt.__index = function(self, key)
                if key == "WalkSpeed" and self == hum then
                    return 16
                end
                return oldIndex(self, key)
            end
        end
    end)
end

