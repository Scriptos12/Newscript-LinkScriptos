-- Слайдер
local function mkSlider(lblTxt, init, min, max, cb, pos)
    local sl = Instance.new("Frame", sliderBox)
    sl.Size = UDim2.new(1, 0, 0, 22)
    sl.Position = UDim2.new(0, 0, pos, 0)
    sl.BackgroundColor3 = Color3.fromRGB(30, 30, 45)
    Instance.new("UICorner", sl).CornerRadius = UDim.new(0, 6)
    local fl = Instance.new("Frame", sl)
    fl.Size = UDim2.new(0, 0, 1, 0)
    fl.BackgroundColor3 = Color3.fromRGB(0, 200, 255)
    Instance.new("UICorner", fl).CornerRadius = UDim.new(0, 6)
    local kn = Instance.new("TextButton", sl)
    kn.Size = UDim2.new(0, 18, 0, 18)
    kn.Position = UDim2.new(0, 0, 0.5, -9)
    kn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    kn.Text = ""
    kn.AutoButtonColor = false
    Instance.new("UICorner", kn).CornerRadius = UDim.new(1, 0)
    local lbl = Instance.new("TextLabel", sl)
    lbl.Size = UDim2.new(1, -10, 1, 0)
    lbl.Position = UDim2.new(0, 5, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = lblTxt .. ": " .. init
    lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 10
    lbl.TextXAlignment = Enum.TextXAlignment.Left

    local drag = false
    local function upd(x)
        local ap, asz = sl.AbsolutePosition, sl.AbsoluteSize
        if asz.X <= 0 then return end
        local rel = math.clamp((x - ap.X) / asz.X, 0, 1)
        kn.Position = UDim2.new(rel, -9, 0.5, -9)
        fl.Size = UDim2.new(rel, 0, 1, 0)
        local v = math.floor(min + (max - min) * rel + 0.5)
        lbl.Text = lblTxt .. ": " .. v
        cb(v)
    end
    kn.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then drag = true end
    end)
    sl.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
            drag = true
            upd(i.Position.X)
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if drag and (i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseMovement) then
            upd(i.Position.X)
        end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then drag = false end
    end)
end

mkSlider("Speed", sp, 16, 300, function(v)
