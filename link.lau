--   ЛОГИКА
-- ═══════════════════════════════════════════════════════════

-- Fly
local bv, bg, fc
local function startF()
    local c = LP.Character if not c then return end
    local h = c:FindFirstChild("HumanoidRootPart") if not h then return end
    bv = Instance.new("BodyVelocity", h) bv.MaxForce = Vector3.new(9e9,9e9,9e9) bv.Velocity = Vector3.new()
    bg = Instance.new("BodyGyro", h) bg.MaxTorque = Vector3.new(9e9,9e9,9e9) bg.CFrame = h.CFrame
    fc = RS.RenderStepped:Connect(function()
        if not flags.Fly or not bv or not bv.Parent then return end
        local d = Vector3.new()
        if UIS:IsKeyDown(Enum.KeyCode.W) then d = d + W.CurrentCamera.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then d = d - W.CurrentCamera.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then d = d - W.CurrentCamera.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then d = d + W.CurrentCamera.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then d = d + Vector3.new(0,1,0) end
        if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then d = d - Vector3.new(0,1,0) end
        bv.Velocity = d * fsp
    end)
end
local function stopF()
    if fc then fc:Disconnect() fc = nil end
    if bv then bv:Destroy() bv = nil end
    if bg then bg:Destroy() bg = nil end
end

-- Noclip
RS.Stepped:Connect(function()
    if not flags.Noclip or not LP.Character then return end
    for _, v in pairs(LP.Character:GetDescendants()) do
        if v:IsA("BasePart") and v.CanCollide then v.CanCollide = false end
    end
end)

-- Speed/Jump loop
RS.Heartbeat:Connect(function()
    if not LP.Character then return end
    local h = LP.Character:FindFirstChildOfClass("Humanoid")
    if not h then return end
    if flags.Speed and h.WalkSpeed ~= sp then h.WalkSpeed = sp end
    if flags.Jump and (h.JumpPower ~= jp or not h.UseJumpPower) then h.JumpPower = jp h.UseJumpPower = true end
end)

-- Inf Jump
UIS.JumpRequest:Connect(function()
    if flags.InfJump and LP.Character then
        local h = LP.Character:FindFirstChildOfClass("Humanoid")
        if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end)

-- No Gravity
local ngf
local function setNG(on)
    if ngf then ngf:Destroy() ngf = nil end
    if on and LP.Character then
        local hrp = LP.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            ngf = Instance.new("BodyForce", hrp)
            ngf.Force = Vector3.new(0, W.Gravity * hrp.AssemblyMass, 0)
        end
    end
end

-- Click TP
UIS.InputBegan:Connect(function(i)
    if not flags.ClickTP then return end
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        local mouse = UIS:GetMouseLocation()
        local ray = W.CurrentCamera:ViewportPointToRay(mouse.X, mouse.Y)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = {LP.Character}
        local res = W:Raycast(ray.Origin, ray.Direction * 500, params)
        if res and LP.Character then
            local hrp = LP.Character:FindFirstChild("HumanoidRootPart")
            if hrp then hrp.CFrame = CFrame.new(res.Position + Vector3.new(0,4,0)) end
        end
    end
end)

-- Ghost Trail
local trailParts = {}
local gtc
local function setGR(on)
    if gtc then gtc:Disconnect() gtc = nil end
    if on then
        gtc = RS.Heartbeat:Connect(function()
            if not flags.GhostTrail or not LP.Character then return end
            local hrp = LP.Character:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            local ghost = Instance.new("Part")
            ghost.Size = Vector3.new(2,3,1) ghost.CanCollide = false
            ghost.Anchored = true ghost.Material = Enum.Material.Neon
            ghost.Color = Color3.fromHSV(tick()%5/5,1,1)
            ghost.CFrame = hrp.CFrame
            ghost.Parent = W
            table.insert(trailParts, ghost)
            task.delay(1, function()
                if ghost and ghost.Parent then ghost:Destroy() end
                for i, v in ipairs(trailParts) do if v == ghost then table.remove(trailParts, i) break end end
            end)
        end)
    else
        for _, gr in pairs(trailParts) do if gr and gr.Parent then gr:Destroy() end end
        trailParts = {}
    end
end

-- Spin
local spc
local function setSP(on)
    if spc then spc:Disconnect() spc = nil end
    if on then
        spc = RS.RenderStepped:Connect(function()
            if not flags.Spin or not LP.Character then return end
            local hrp = LP.Character:FindFirstChild("HumanoidRootPart")
            if hrp then hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(5), 0) end
        end)
    end
end

-- TP to nearest player
UIS.InputBegan:Connect(function(i)
    if not flags.TPToPlayer then return end
    if i.KeyCode == Enum.KeyCode.E then
        local closest, dist = nil, math.huge
        for _, pl in pairs(P:GetPlayers()) do
            if pl ~= LP and pl.Character then
                local hrp = pl.Character:FindFirstChild("HumanoidRootPart")
                if hrp and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
                    local d = (hrp.Position - LP.Character.HumanoidRootPart.Position).Magnitude
                    if d < dist then dist = d closest = hrp end
                end
            end
        end
        if closest and LP.Character then
            local hrp = LP.Character:FindFirstChild("HumanoidRootPart")
            if hrp then hrp.CFrame = CFrame.new(closest.Position + Vector3.new(0,3,0)) end
        end
    end
end)

-- Float
local flc
local function setFL(on)
    if flc then flc:Disconnect() flc = nil end
    if on then
        flc = RS.Heartbeat:Connect(function()
            if not flags.Float or not LP.Character then return end
            local hrp = LP.Character:FindFirstChild("HumanoidRootPart")
            if hrp then hrp.Velocity = Vector3.new(hrp.Velocity.X, 0, hrp.Velocity.Z) end
        end)
    end
end

-- Bhop
local bhc
local function setBH(on)
    if bhc then bhc:Disconnect() bhc = nil end
    if on then
        bhc = RS.Heartbeat:Connect(function()
            if not flags.Bhop or not LP.Character then return end
            local h = LP.Character:FindFirstChildOfClass("Humanoid")
            if h and h.MoveDirection.Magnitude > 0 and h:GetState() == Enum.HumanoidStateType.Running then
                h:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end)
    end
end

-- Long Strafe
local lsc
local function setLS(on)
    if lsc then lsc:Disconnect() lsc = nil end
    if on then
        lsc = RS.Heartbeat:Connect(function()
            if not flags.LongStrafe or not LP.Character then return end
            local h = LP.Character:FindFirstChildOfClass("Humanoid")
            if h then
                local md = h.MoveDirection
                if math.abs(md.X) > 0.3 and math.abs(md.Z) > 0.3 then
                    if h.WalkSpeed < sp*1.3 then h.WalkSpeed = sp*1.3 end
                end
            end
        end)
    end
end

-- High Ping TP
local hpc
local function setHP(on)
    if hpc then hpc:Disconnect() hpc = nil end
    if on then
        hpc = RS.Heartbeat:Connect(function()
            if not flags.HighPingTP or not LP.Character then return end
            local hrp = LP.Character:FindFirstChild("HumanoidRootPart")
            if hrp and hrp.Velocity.Magnitude > 500 then
                hrp.Velocity = hrp.Velocity * 0.3
            end
        end)
    end
end

-- No Fall Damage
local function setNF(on)
    if LP.Character then
        local h = LP.Character:FindFirstChildOfClass("Humanoid")
        if h then h:SetStateEnabled(Enum.HumanoidStateType.FallingDown, not on) end
    end
end

-- No Clip Camera
local ncc2
local function setNC(on)
    if ncc2 then ncc2:Disconnect() ncc2 = nil end
    if not on and W.CurrentCamera and LP.Character then
        W.CurrentCamera.CameraSubject = LP.Character:FindFirstChildOfClass("Humanoid")
    end
end

-- Speed Mask
local smc
local function setSM(on)
    if smc then smc:Disconnect() smc = nil end
    if on then
        smc = RS.Heartbeat:Connect(function()
            if not flags.SpeedMask or not LP.Character then return end
            local h = LP.Character:FindFirstChildOfClass("Humanoid")
            if not h then return end
            if tick() % 2 < 0.05 and flags.Speed then h.WalkSpeed = 16 end
        end)
    end
end

-- 🏃 DASH (новая функция)
-- Быстрый рывок вперёд с кулдауном
local dashCD = false
local function doDash()
    if dashCD or not LP.Character then return end
    local hrp = LP.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    dashCD = true
    local dir = hrp.CFrame.LookVector
    local bvDash = Instance.new("BodyVelocity", hrp)
    bvDash.MaxForce = Vector3.new(9e9,9e9,9e9)
    bvDash.Velocity = dir * 120
    task.delay(0.25, function()
        if bvDash then bvDash:Destroy() end
    end)
    task.delay(1.5, function() dashCD = false end)
end

-- 🦅 HIGH JUMP (новая функция)
-- Прыжок в 3 раза выше при нажатии Space
local function doHighJump()
    if not LP.Character then return end
    local h = LP.Character:FindFirstChildOfClass("Humanoid")
    if not h then return end
    local hrp = LP.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    h:ChangeState(Enum.HumanoidStateType.Jumping)
    local bvJ = Instance.new("BodyVelocity", hrp)
    bvJ.MaxForce = Vector3.new(9e9,9e9,9e9)
    bvJ.Velocity = Vector3.new(hrp.Velocity.X, 150, hrp.Velocity.Z)
    task.delay(0.2, function()
        if bvJ then bvJ:Destroy() end
    end)
end

UIS.JumpRequest:Connect(function()
    if flags.HighJump then doHighJump() end
end)

-- 👁️ NAME ESP (новая функция)
local nameESPData = {}
local function createNameESP(pl)
    if pl == LP or not pl.Character then return end
    if nameESPData[pl] and nameESPData[pl].Parent then return end
    local head = pl.Character:FindFirstChild("Head")
    if not head then return end
    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(0, 100, 0, 20)
    bb.StudsOffset = Vector3.new(0, 2.5, 0)
    bb.AlwaysOnTop = true
    bb.Parent = head
    local lbl = Instance.new("TextLabel", bb)
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = pl.Name
    lbl.TextColor3 = Color3.fromRGB(0, 220, 255)
    lbl.TextStrokeTransparency = 0
    lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    lbl.TextScaled = true
    lbl.Font = Enum.Font.GothamBold
    nameESPData[pl] = bb
end
local function setNameESP(on)
    if on then
        for _, pl in pairs(P:GetPlayers()) do createNameESP(pl) end
    else
        for pl, bb in pairs(nameESPData) do if bb then bb:Destroy() end end
        nameESPData = {}
    end
end
P.PlayerAdded:Connect(function(pl)
    pl.CharacterAdded:Connect(function() if flags.NameESP then task.wait(0.4) createNameESP(pl) end end)
end)
P.PlayerRemoving:Connect(function(pl) if nameESPData[pl] then nameESPData[pl]:Destroy() nameESPData[pl] = nil end end)

-- Fullbright
local fbSaved = false
local oAmb, oBr, oCl, oOut
local function setFB(on)
    if on then
        if not fbSaved then
            oAmb = L.Ambient oBr = L.Brightness oCl = L.ClockTime oOut = L.OutdoorAmbient
            fbSaved = true
        end
        L.Ambient = Color3.fromRGB(178,178,178) L.Brightness = 3 L.ClockTime = 12 L.OutdoorAmbient = Color3.fromRGB(178,178,178)
    elseif fbSaved then
        if oAmb then L.Ambient = oAmb end
        if oBr then L.Brightness = oBr end
        if oCl then L.ClockTime = oCl end
        if oOut then L.OutdoorAmbient = oOut end
    end
end

-- No Fog
local nfSaved = false
local oFc, oFe, oFs
local function setRF(on)
    if on then
        if not nfSaved then
            oFc = L.FogColor oFe = L.FogEnd oFs = L.FogStart
            nfSaved = true
        end
        L.FogColor = Color3.fromRGB(255,255,255) L.FogEnd = 1e6 L.FogStart = 1e6
    elseif nfSaved then
        if oFc then L.FogColor = oFc end
        if oFe then L.FogEnd = oFe end
        if oFs then L.FogStart = oFs end
    end
end

-- ESP
local ehl = {}
local function createESPFor(pl)
    if pl == LP or not pl.Character then return end
    if ehl[pl] and ehl[pl].Parent then ehl[pl]:Destroy() end
    local hl = Instance.new("Highlight")
    hl.FillColor = Color3.fromRGB(255,50,50)
    hl.OutlineColor = Color3.fromRGB(255,255,255)
    hl.Parent = pl.Character
    ehl[pl] = hl
end
local function setESP(on)
    if on then
        for _, pl in pairs(P:GetPlayers()) do createESPFor(pl) end
    else
        for pl, hl in pairs(ehl) do if hl then hl:Destroy() end end
        ehl = {}
    end
end
P.PlayerAdded:Connect(function(pl)
    pl.CharacterAdded:Connect(function() if flags.ESP then task.wait(0.4) createESPFor(pl) end end)
end)
P.PlayerRemoving:Connect(function(pl) if ehl[pl] then ehl[pl]:Destroy() ehl[pl] = nil end end)

-- Aim Assist
local aac2
local function setAA(on)
    if aac2 then aac2:Disconnect() aac2 = nil end
    if on then
        aac2 = RS.RenderStepped:Connect(function()
            if not flags.AimAssist or not LP.Character then return end
            local cam = W.CurrentCamera
            if not cam then return end
            local closest, dist = nil, math.huge
            for _, pl in pairs(P:GetPlayers()) do
                if pl ~= LP and pl.Character then
                    local hrp = pl.Character:FindFirstChild("HumanoidRootPart")
                    if hrp and LP.Character:FindFirstChild("HumanoidRootPart") then
                        local d = (hrp.Position - LP.Character.HumanoidRootPart.Position).Magnitude
                        if d < dist then dist = d closest = hrp end
                    end
                end
            end
            if closest and dist < (fa*10) then
                local newCF = CFrame.new(cam.CFrame.Position, closest.Position)
                cam.CFrame = cam.CFrame:Lerp(newCF, 0.15)
            end
        end)
    end
end

-- X-Ray
local xrParts = {}
local function setXR(on)
    if on then
        for _, v in pairs(W:GetDescendants()) do
            if v:IsA("BasePart") and v.Transparency < 1 then
                if not LP.Character or not v:IsDescendantOf(LP.Character) then
                    xrParts[v] = v.Transparency
                    v.Transparency = 0.7
                end
            end
        end
    else
        for v, tr in pairs(xrParts) do if v and v.Parent then v.Transparency = tr end end
        xrParts = {}
    end
end

-- Invisible
local invParts = {}
local function setINV(on)
    if on and LP.Character then
        for _, v in pairs(LP.Character:GetDescendants()) do
            if v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" then
                invParts[v] = v.Transparency
                v.Transparency = 1
            end
            if v:IsA("Decal") then
                invParts[v] = v.Transparency
                v.Transparency = 1
            end
        end
    else
        for v, tr in pairs(invParts) do if v and v.Parent then v.Transparency = tr end end
        invParts = {}
    end
end

-- Skeleton ESP
local skelParts = {}
local skc
local function setSK(on)
    if skc then skc:Disconnect() skc = nil end
    if on then
        skc = RS.Heartbeat:Connect(function()
            if not flags.SkeletonESP then return end
            for _, pl in pairs(P:GetPlayers()) do
                if pl ~= LP and pl.Character then
                    local hrp = pl.Character:FindFirstChild("HumanoidRootPart")
                    if hrp and (not skelParts[pl] or not skelParts[pl].Parent) then
                        local box = Instance.new("BoxHandleAdornment")
                        box.Size = Vector3.new(2,5,1)
                        box.Adornee = hrp
                        box.AlwaysOnTop = true
                        box.ZIndex = 5
                        box.Transparency = 0.5
                        box.Color3 = Color3.fromRGB(0,255,0)
                        box.Parent = hrp
                        skelParts[pl] = box
                    end
                end
            end
        end)
    else
        for _, v in pairs(skelParts) do if v and v.Parent then v:Destroy() end end
        skelParts = {}
    end
end

-- First Person
local function setFM(on)
    if LP.Character then
        local h = LP.Character:FindFirstChildOfClass("Humanoid")
        if h then h.CameraMode = on and Enum.CameraMode.LockFirstPerson or Enum.CameraMode.Classic end
    end
end

-- Ghost Mode
local ghc
local function setGH(on)
    if ghc then ghc:Disconnect() ghc = nil end
    if on then
        ghc = RS.Heartbeat:Connect(function()
            if not flags.GhostMode or not LP.Character then return end
            for _, v in pairs(LP.Character:GetDescendants()) do
                if v:IsA("BasePart") and not flags.Invisible then v.Transparency = 0.5 end
            end
        end)
    elseif LP.Character and not flags.Invisible then
        for _, v in pairs(LP.Character:GetDescendants()) do
            if v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" then v.Transparency = 0 end
        end
    end
end

-- Anti-Kick
local function setIL(on)
    if on and LP:FindFirstChild("PlayerGui") then
        LP.PlayerGui.Enabled = true
    end
end

-- Walk on Water
local wtc
local function setWT(on)
    if wtc then wtc:Disconnect() wtc = nil end
    if LP.Character then
        local h = LP.Character:FindFirstChildOfClass("Humanoid")
        if h then h:SetStateEnabled(Enum.HumanoidStateType.Swimming, not on) end
    end
end

-- Auto Click
local msc
local function setMS(on)
    if msc then msc:Disconnect() msc = nil end
    if on then
        msc = RS.Heartbeat:Connect(function()
            if not flags.AutoClick then return end
            pcall(function() VU:CaptureController() VU:ClickButton1(Vector2.new(0,0)) end)
        end)
    end
end

-- Fly Trail
local ftTrail, ftAtt0, ftAtt1
local function setFT(on)
    if ftTrail then ftTrail:Destroy() ftTrail = nil end
    if ftAtt0 then ftAtt0:Destroy() ftAtt0 = nil end
    if ftAtt1 then ftAtt1:Destroy() ftAtt1 = nil end
    if on and LP.Character then
        local hrp = LP.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            ftAtt0 = Instance.new("Attachment", hrp) ftAtt0.Position = Vector3.new(0,1,0)
            ftAtt1 = Instance.new("Attachment", hrp) ftAtt1.Position = Vector3.new(0,-1,0)
            ftTrail = Instance.new("Trail", hrp)
            ftTrail.Attachment0 = ftAtt0
            ftTrail.Attachment1 = ftAtt1
            ftTrail.Lifetime = 1
            ftTrail.Color = ColorSequence.new(Color3.fromHSV(tick()%5/5,1,1), Color3.fromHSV((tick()+1)%5/5,1,1))
        end
    end
end

-- Water Speed
local wsc
local function setWS2(on)
    if wsc then wsc:Disconnect() wsc = nil end
    if on then
        wsc = RS.Heartbeat:Connect(function()
            if not flags.WaterSpeed or not LP.Character then return end
            local h = LP.Character:FindFirstChildOfClass("Humanoid")
            if h and h:GetState() == Enum.HumanoidStateType.Swimming then
                if h.WalkSpeed ~= sp*1.5 then h.WalkSpeed = sp*1.5 end
            end
        end)
    end
end

-- Rainbow Body
local rbc
local function setRR(on)
    if rbc then rbc:Disconnect() rbc = nil end
    if on then
        rbc = RS.Heartbeat:Connect(function()
            if not flags.RainbowBody or not LP.Character then return end
            for _, v in pairs(LP.Character:GetDescendants()) do
                if v:IsA("BasePart") then v.Color = Color3.fromHSV(tick()%5/5,1,1) end
            end
        end)
    end
end

-- Click Sound
local csc
local function setCB(on)
    if csc then csc:Disconnect() csc = nil end
    if on then
        csc = UIS.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                local s = Instance.new("Sound")
                s.SoundId = "rbxassetid://131237241"
                s.Volume = 0.5
                s.Parent = W
                s:Play()
                task.delay(2, function() if s then s:Destroy() end end)
            end
        end)
    end
end

-- Respawn
LP.CharacterAdded:Connect(function(c)
    task.wait(0.5)
    local h = c:FindFirstChildOfClass("Humanoid")
    if not h then return end
    if flags.Noclip then for _, v in pairs(c:GetDescendants()) do if v:IsA("BasePart") then v.CanCollide = false end end end
    if flags.Speed then h.WalkSpeed = sp end
    if flags.Jump then h.JumpPower = jp h.UseJumpPower = true end
    if flags.NoGrav then task.wait(0.1) setNG(true) end
    if flags.FirstPerson then h.CameraMode = Enum.CameraMode.LockFirstPerson end
    if flags.ESP then for _, pl in pairs(P:GetPlayers()) do createESPFor(pl) end end
    if flags.NameESP then for _, pl in pairs(P:GetPlayers()) do createNameESP(pl) end end
end)

-- ═══════════════════════════════════════════════════════════
--   ПРИВЯЗКА КНОПОК
-- ═══════════════════════════════════════════════════════════
local function toggle(b, flagKey, label, onFn, offFn)
    b.MouseButton1Click:Connect(function()
        local flag = not flags[flagKey]
        flags[flagKey] = flag
        b.Text = label .. ": " .. (flag and "ВКЛ" or "ВЫКЛ")
        b.BackgroundColor3 = flag and Color3.fromRGB(0,130,70) or Color3.fromRGB(28,28,42)
        if flag then if onFn then pcall(onFn) end else if offFn then pcall(offFn) end end
    end)
end

toggle(bF,  "Fly",         "Fly",           startF, stopF)
toggle(bS,  "Speed",       "Speed",         nil, function()
    if LP.Character then local h = LP.Character:FindFirstChildOfClass("Humanoid") if h then h.WalkSpeed = 16 end end
end)
toggle(bJ,  "Jump",        "Jump",          nil, function()
    if LP.Character then local h = LP.Character:FindFirstChildOfClass("Humanoid") if h then h.JumpPower = 50 end end
end)
toggle(bN,  "Noclip",      "Noclip",        nil, function()
    if LP.Character then for _, v in pairs(LP.Character:GetDescendants()) do
        if v:IsA("BasePart") then v.CanCollide = true end end end
end)
