-- Вкладки
local function setTab(name)
    local all = {bF,bS,bJ,bN,bI,bA,bNG,bCC,bGR,bSP,bTP,bFL,bBH,bLS,bHP,bNF,bNC,bSM,bDA,bHJ,
                 bFB,bRF,bE,bAA,bXR,bINV,bSK,bFM,bGH,bNE,bIL,bWT,bMS,bFT,bWS2,bRR,bCB}
    for _, b in pairs(all) do b.Visible = false end
    tabMove.BackgroundColor3 = (name=="move") and Color3.fromRGB(0,150,200) or Color3.fromRGB(30,30,45)
    tabVis.BackgroundColor3  = (name=="vis")  and Color3.fromRGB(0,150,200) or Color3.fromRGB(30,30,45)
    tabMisc.BackgroundColor3 = (name=="misc") and Color3.fromRGB(0,150,200) or Color3.fromRGB(30,30,45)
    tabMove.TextColor3 = (name=="move") and Color3.fromRGB(255,255,255) or Color3.fromRGB(180,180,200)
    tabVis.TextColor3  = (name=="vis")  and Color3.fromRGB(255,255,255) or Color3.fromRGB(180,180,200)
    tabMisc.TextColor3 = (name=="misc") and Color3.fromRGB(255,255,255) or Color3.fromRGB(180,180,200)
    if name == "move" then
        for _, b in pairs({bF,bS,bJ,bN,bI,bA,bNG,bCC,bGR,bSP,bTP,bFL,bBH,bLS,bHP,bNF,bNC,bSM,bDA,bHJ}) do b.Visible = true end
    elseif name == "vis" then
        for _, b in pairs({bFB,bRF,bE,bAA,bXR,bINV,bSK,bFM,bGH,bNE}) do b.Visible = true end
    else
        for _, b in pairs({bIL,bWT,bMS,bFT,bWS2,bRR,bCB}) do b.Visible = true end
    end
end
tabMove.MouseButton1Click:Connect(function() setTab("move") end)
tabVis.MouseButton1Click:Connect(function() setTab("vis") end)
tabMisc.MouseButton1Click:Connect(function() setTab("misc") end)
setTab("move")

-- Перетаскивание кнопки M
local dm, ds, dp, mv = false, nil, nil, false
m.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
        dm = true mv = false ds = i.Position dp = m.Position
    end
end)
UIS.InputChanged:Connect(function(i)
    if dm and (i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseMovement) then
        local d = i.Position - ds
        if math.abs(d.X) > 5 or math.abs(d.Y) > 5 then mv = true end
        m.Position = UDim2.new(dp.X.Scale, dp.X.Offset + d.X, dp.Y.Scale, dp.Y.Offset + d.Y)
    end
end)
UIS.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
        if dm and not mv then f.Visible = true m.Visible = false end
        dm = false
    end
end)

